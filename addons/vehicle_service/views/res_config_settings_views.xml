<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_vehicle_service" model="ir.ui.view">
        <field name="name">res.config.settings.vehicle.service</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Vehicle Service" name="vehicle_service">
                    <block title="Workshop Inventory">
                        <setting
                            string="Workshop Stock Location"
                            help="Inventory location used for workshop repairs.">
                            <field
                                name="workshop_location_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
