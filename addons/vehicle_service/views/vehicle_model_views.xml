<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Model List View -->
    <record id="view_vehicle_model_list" model="ir.ui.view">
        <field name="name">vehicle.model.list</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <tree default_order="manufacturer_id,name">
                <field name="manufacturer_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Model Form View -->
    <record id="view_vehicle_model_form" model="ir.ui.view">
        <field name="name">vehicle.model.form</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="manufacturer_id"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Model Search View -->
    <record id="view_vehicle_model_search" model="ir.ui.view">
        <field name="name">vehicle.model.search</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="manufacturer_id"/>
                <field name="code"/>
                <separator/>
                <filter 
                    name="active" 
                    string="Active" 
                    domain="[('active', '=', True)]" 
                    />
                <filter 
                    name="archived" 
                    string="Archived" 
                    domain="[('active', '=', False)]" 
                    />
                <separator/>
                <group string="Group By">
                    <filter 
                        name="manufacturer" 
                        string="Manufacturer" 
                        context="{'group_by': 'manufacturer_id'}" 
                        />
                </group>
            </search>
        </field>
    </record>

    <!-- Model Action -->
    <record id="action_vehicle_model" model="ir.actions.act_window">
        <field name="name">Vehicle Models</field>
        <field name="res_model">vehicle.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vehicle_model_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle model.
            </p>
            <p>
                Manage vehicle models for different manufacturers.
            </p>
        </field>
    </record>

</odoo>
