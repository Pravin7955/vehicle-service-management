<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vehicle List View -->
    <record id="view_vehicle_list" model="ir.ui.view">
        <field name="name">vehicle.vehicle.list</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="registration_number"/>
                <field name="make"/>
                <field name="model"/>
                <field name="owner_id"/>
                <field name="year"/>
            </tree>
        </field>
    </record>

    <!-- Vehicle Action -->
    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
