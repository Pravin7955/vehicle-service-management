<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vehicle List View -->
    <record id="view_vehicle_list" model="ir.ui.view">
        <field name="name">vehicle.vehicle.list</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="registration_number"/>
                <field name="make"/>
                <field name="model"/>
                <field name="owner_id"/>
                <field name="year"/>
            </tree>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="registration_number"/>
                        <h1>
                            <field name="registration_number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="make"/>
                            <field name="model"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="vehicle_age" readonly="1"/>
                            <field name="owner_phone" readonly="1"/>
                            <field name="owner_email" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Cost Details">
                        <group>
                            <field name="parts_cost"/>
                            <field name="labour_cost"/>
                        </group>
                        <group>
                            <field name="total_cost" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vehicle Action -->
    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle.
            </p>
            <p>
                Manage customer vehicles
                and their service information.
            </p>
        </field>
    </record>

</odoo>
